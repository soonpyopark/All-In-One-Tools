<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI (no admin rights needed) for the Electron app.
  Built by scripts/build-release.mjs with:
    -d AppName=… -d ExeName=… -d ProductVersion=x.y.z.n -d ProductCode={guid}
    -d StageDir=<absolute path of the unpacked app> -d InstallerDir=<this folder>

  AppUserModelID 는 MSI ShortcutProperty 로 넣지 않는다.
  (설치 중 Warning 1946 팝업이 자주 뜸 — 검색·PowerToys 등이 .lnk 를 잠그면 실패)
  프로세스 ID 는 main.js 의 app.setAppUserModelId 로 고정한다.

  Mutable state (settings) lives in %APPDATA% — never inside
  the install folder — so upgrades and uninstalls cannot wipe it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="$(AppName)"
    Manufacturer="$(AppName)"
    Version="$(ProductVersion)"
    ProductCode="$(ProductCode)"
    UpgradeCode="A1B2C3D4-E5F6-4789-A012-3456789ABCDE"
    Scope="perUser"
    Compressed="yes">

    <SummaryInformation Description="$(AppName)" />

    <!-- A new ProductCode + AllowSameVersionUpgrades lets every build replace the previous one. -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of $(AppName) is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(StageDir)\app-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(InstallerDir)\License.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="$(AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="ProductFeature" Title="$(AppName)" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(StageDir)\**" />

      <Component
        Id="StartMenuShortcut"
        Directory="ApplicationProgramsFolder"
        Guid="2B6F1A44-8C3D-4E57-9A02-71D5C8E3B610">
        <!-- Icon 은 exe 에 내장된 것을 쓴다. WiX Icon 테이블을 쓰면 재부팅·업그레이드 후 캐시가 깨져 흰 아이콘이 된다. -->
        <Shortcut
          Id="StartMenuShortcutLink"
          Name="$(AppName)"
          Description="$(AppName)"
          Target="[INSTALLFOLDER]$(ExeName)"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\$(AppName)"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>

      <Component
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Guid="9E0D7C25-4B81-47A9-B3F6-0A52D1C8E974">
        <Shortcut
          Id="DesktopShortcutLink"
          Name="$(AppName)"
          Description="$(AppName)"
          Target="[INSTALLFOLDER]$(ExeName)"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue
          Root="HKCU"
          Key="Software\$(AppName)"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
