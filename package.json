{
  "name": "all-tools",
  "productName": "AllTools",
  "version": "1.0.0",
  "description": "All-Tools: Electron app with video-to-GIF conversion and extensible tools.",
  "main": "main.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm run prepare:icons && electron .",
    "dev:stop": "node scripts/dev-process.mjs stop",
    "dev:restart": "node scripts/dev-process.mjs restart",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "prepare:ocr": "node scripts/ensure-ocr-models.mjs",
    "build": "npm run prepare:icons && npm run prepare:ocr && vite build",
    "build:release": "node scripts/build-release.mjs",
    "build:release:mac": "node scripts/build-release-mac.mjs",
    "update:all": "node scripts/update-all.mjs",
    "build:update_all": "update_all.bat _inner && npm run build:release",
    "build:update_all:mac": "node scripts/update-all.mjs && npm run build:release:mac",
    "start": "npm run build && electron .",
    "stamp": "node scripts/sync-build-stamp.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "frame",
    "boilerplate"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.32",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@nuintun/qrcode": "^5.1.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "fflate": "^0.8.3",
    "jsqr": "^1.4.0",
    "mupdf": "^1.28.6",
    "onnxruntime-node": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.alltools.app",
    "productName": "AllTools",
    "icon": "build/icon.png",
    "directories": {
      "output": ".dist-build"
    },
    "files": [
      "main.js",
      "preload.cjs",
      "electron/**/*",
      "shared/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/@nut-tree-fork/**/*",
      "node_modules/onnxruntime-node/**/*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "ocr/models",
        "to": "ocr/models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "identity": null,
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dir"
        }
      ]
    }
  },
  "allowScripts": {
    "onnxruntime-node@1.23.2": true,
    "electron@45.3.1": true
  }
}
